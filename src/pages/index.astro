---
import Base from '../layouts/Base.astro';
import Commit from '../components/Commit.astro';
import { getPosts } from '../lib/posts';
import { SITE } from '../site';

const posts = await getPosts();
const head = posts[0];
---

<Base>
  <section class="hero">
    <div class="shell">
      <p class="mono hero__eyebrow">
        HEAD → {head ? `${head.version} · ${head.data.pubDate.toISOString().slice(0, 10)}` : 'empty log'}
      </p>
      <h1 class="hero__title">Data Engineering <em>Field Notes</em></h1>
      <p class="hero__lede">
        {SITE.description}
      </p>
    </div>
  </section>

  <section class="log">
    <div class="shell">
      <p class="mono log__heading">
        {posts.length} {posts.length === 1 ? 'entry' : 'entries'} · newest first
      </p>
      <ol class="log__list">
        {posts.map((post, i) => <Commit post={post} index={i} />)}
      </ol>
    </div>
  </section>
</Base>
