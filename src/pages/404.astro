---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="No entry at this path.">
  <section class="hero">
    <div class="shell">
      <p class="mono hero__eyebrow">404 · NO SUCH VERSION</p>
      <h1 class="hero__title">That entry isn't in the log.</h1>
      <p class="hero__lede">
        The path may have changed when the post was renamed. <a href="/">Go back to the log</a>
        and pick it up from there.
      </p>
    </div>
  </section>
</Base>
