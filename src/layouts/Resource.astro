---
import type { MarkdownLayoutProps } from 'astro';
import Base from './Base.astro';

type Props = MarkdownLayoutProps<{
  title: string;
  description: string;
}>;

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article class="article">
    <div class="shell">
      <header class="article__head">
        <p class="mono article__stamp">Supporting resource</p>
        <h1 class="article__title">{frontmatter.title}</h1>
        <p class="article__desc">{frontmatter.description}</p>
      </header>
      <div class="prose resource-content">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .resource-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
</style>
